+        debug_queue_wait[core][stage][6] = port_uxCriticalNesting[core];
+        debug_queue_wait[core][stage][7] = port_uxOldInterruptState[core];
+    }
+    portCLEAR_INTERRUPT_MASK_FROM_ISR(irq);
