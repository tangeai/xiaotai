# 字段含义与接入影响见包根目录 README.md。
SDK_NAME=TiRTC-Nano
SDK_VERSION=v2.5.0
TARGET=beken-bk7258
VARIANT=mini
ARCH=arm
ABI=eabi-hard-float
TARGET_RTOS=vendor-rtos
LIBC=vendor-libc
BUILD_TOOLCHAIN=GCC
BUILD_TOOLCHAIN_VERSION=10.3.1
BUILD_PLATFORM_SDK=BK-AVDK
BUILD_PLATFORM_SDK_VERSION=3.1.1.8-official-1cfd56af
MEMORY_PROFILE=small
P2P=enabled
SCTP=disabled
SSL=disabled
DTLS=disabled
TLS_PROVIDER=platform-sdk
TLS_COMPONENT=psa_mbedtls
MBEDTLS_VERSION=3.5.2
BUNDLED_MBEDTLS=no
