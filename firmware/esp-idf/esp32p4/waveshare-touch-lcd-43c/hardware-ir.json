    "issues": [
      {
        "id": "es7210-slot-mapping",
        "detail": "原理图显示板载双麦克风接 ES7210 MIC2_P/MIC2_N（差分对），ES8311 OUTN 经 R81+1uF 耦合至 ADC_MIC3_N 作回采参考；TDM 串行顺序 CH1/CH3/CH2/CH4 与参考通道在 slot 中的具体索引需在 bring-up 用 i2c_tools 与声道实测确认（复用 lckfb 的 MIC1/MIC3 压实机制，改 mic_select 通道掩码）。",
        "classification": "implementation_resolvable"
      },
      {
        "id": "es7210-i2c-addr",
        "detail": "ES8311 固定 0x40；ES7210 地址由 AD0/AD1 跳线决定（J303-J306），可能与 0x40 冲突，bring-up 时探测 0x40/0x41/0x42。",
        "classification": "hil_resolvable"
      },
      {
        "id": "key-button-mapping",
        "detail": "原理图 K1=GPIO21、K2=GPIO23、K3=GPIO28；POWER 按键与 PMIC/电源路径（U2003 KEY、U1701 开关）的联动以及 K2/K3 的产品语义需真机确认；BOOT 为 GPIO35 strap，RESET 为 EN。",
        "classification": "hil_resolvable"
      },
      {
        "id": "vendor-bsp-touch-rst-conflict",
        "detail": "vendor BSP 07/08 例程 touch RST=GPIO23 与本板 K2 按键 GPIO23 冲突；09/11 例程（v1.0.1）为 RST=NC/INT=NC（GT911 轮询模式），与原理图一致，采用后者。",
        "classification": "implementation_resolvable"
      }
    ]
