menu "XiaoTai application"
config STARTER_AI_UPLINK_G711A
    bool
    default y
    help
        Product AI profile: A-law 8 kHz uplink, Opus 16 kHz downlink.
        Capture/AEC keep the board's existing 16 kHz processing domain.

config STARTER_AI_UPLINK_G711A_16K
    bool "AI A-law uplink at 16 kHz (server trial)"
    depends on STARTER_AI_UPLINK_G711A
    default n
    help
        Send the 16 kHz AEC output directly as A-law on AI sessions.
        The AI server must accept alaw/16000/1. Other sessions stay at 8 kHz.

config XIAOTAI_DISCOVERY_URL
    string "ThingConnect service discovery URL"
    default "http://ep-open.tangeopen.com/services"
    help
        Existing development endpoint is retained. Override for your deployment.
        HTTPS requires valid time, trusted certificates and sufficient TLS memory.
config XIAOTAI_WAKE_THRESHOLD_MILLI
    int "Voicute wake threshold (thousandths)"
    range 50 990
    default 700
    help
        Model-specific; requires acoustic validation. Console overrides are volatile.
endmenu
