--- a/cp/middleware/driver/mailbox/mb_ipc_heartbeat.c
+++ b/cp/middleware/driver/mailbox/mb_ipc_heartbeat.c
@@ -16,6 +16,7 @@
 #include <string.h>
 
 #include <os/os.h>
+#include <soc/soc.h>
 #include "mb_ipc_cmd.h"
 #include <modules/pm.h>
 
@@ -85,6 +86,7 @@ static volatile u8                  cpu_x_state = CORE_POWER_OFF;
 static volatile u8                  cpu_x_id = 0xFF;   /* invalid ID, */
 static volatile u8                  cpu_x_dump = 0;
 static volatile u8                  cpu_x_heartbeat_timeout = 0;
+static volatile u32                 s_heartbeat_rx_count = 0;
 static volatile mb_ipc_work_state_e s_mb_ipc_work_state = MB_IPC_WORKING;
 
 void mb_ipc_heartbeat_notify(u32 cpu_id);
@@ -289,6 +291,14 @@ static void mb_ipc_task( void *para )
 		{
 			if(ipc_heartbeat_timeout())
 			{
+				/* These read-only SYS registers remain accessible from CP when AP
+				 * stops responding. Capture halt/power state before the reset. */
+				BK_DUMP_OUT("[DEBUG-bk-hb] ap-hw run=0x%08x cpu1=0x%08x cpu2=0x%08x\r\n",
+					REG_READ(SOC_SYS_REG_BASE + (0x3 << 2)),
+					REG_READ(SOC_SYS_REG_BASE + (0x5 << 2)),
+					REG_READ(SOC_SYS_REG_BASE + (0x6 << 2)));
+				BK_DUMP_OUT("[DEBUG-bk-hb] rx-timeout count=%u\r\n",
+					s_heartbeat_rx_count);
 				BK_LOGE(MOD_TAG, "IPC[%d]heartbeat timeout %d,%d\r\n",cpu_x_id,cpu_x_heartbeat_timestamp,(u32)rtos_get_time());
 				/*when cpu1 heartbeat timeout, then system reboot*/
 				cpu_x_heartbeat_timeout = 1;
@@ -335,6 +345,7 @@ void mb_ipc_heartbeat_notify(u32 cpu_id)
 	{
 		return;
 	}
+	s_heartbeat_rx_count++;
 	rtos_set_event_ex(&mb_ipc_heart_event, MB_IPC_HEARTBEAT_FLAG);
 }
 
