diff --git a/ap/middleware/driver/mailbox/mb_ipc_heartbeat.c b/ap/middleware/driver/mailbox/mb_ipc_heartbeat.c
index 5165e9fa..fc43c9bd 100755
--- a/ap/middleware/driver/mailbox/mb_ipc_heartbeat.c
+++ b/ap/middleware/driver/mailbox/mb_ipc_heartbeat.c
@@ -16,6 +16,8 @@
 #include <string.h>
 
 #include <os/os.h>
+#include <components/log.h>
+#include <components/system.h>
 #include "mb_ipc_cmd.h"
 
 #define MOD_TAG		"hrt"
@@ -340,12 +342,22 @@ int mb_ipc_cpu_is_power_off(u32 cpu_id)
 
 static void mb_ipc_task( void *para )
 {
+	u32 seq = 0;
+	bk_err_t send_rc;
+
 	ipc_send_power_up();
 
 	while(1)
 	{
 		rtos_delay_milliseconds(MB_IPC_HEARTBEAT_TIME);
-		ipc_send_heart_beat(0);
+		seq++;
+		bk_printf_raw_nonblock(BK_LOG_INFO, MOD_TAG,
+			"[DEBUG-bk-hb] tx-enter seq=%u ms=%u\r\n",
+			seq, (u32)rtos_get_time());
+		send_rc = ipc_send_heart_beat(0);
+		bk_printf_raw_nonblock(BK_LOG_INFO, MOD_TAG,
+			"[DEBUG-bk-hb] tx-exit seq=%u rc=%d ms=%u\r\n",
+			seq, send_rc, (u32)rtos_get_time());
 	}
 }
 
@@ -356,7 +368,7 @@ bk_err_t mb_ipc_heartbeat_init(void)
 	bk_err_t	ret_val = BK_FAIL;
 
 #if defined(MASTER_HB_TASK) || defined(SLAVE_HB_TASK)
-	ret_val = rtos_smp_create_thread(NULL, BEKEN_HEARTBEAT_PRIORITY, "heartbeat", mb_ipc_task, 512, 0);
+	ret_val = rtos_create_sram_thread(NULL, BEKEN_HEARTBEAT_PRIORITY, "heartbeat", mb_ipc_task, 1024, 0);
 #endif
 
 	if(ret_val != BK_OK)
